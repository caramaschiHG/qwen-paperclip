{
  "name": "@qwen-paperclip/web",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack web application (API + UI) — identical to Paperclip",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "cd client && vite --port 3000",
    "build": "tsc && cd client && vite build",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "pg": "^8.11.3",
    "drizzle-orm": "^0.29.3",
    "drizzle-kit": "^0.20.10",
    "dotenv": "^16.4.1",
    "zod": "^3.22.4",
    "uuid": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "@qwen-paperclip/agent": "workspace:*",
    "@qwen-paperclip/heartbeat": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "concurrently": "^8.2.2",
    "vite": "^5.0.12"
  }
}
