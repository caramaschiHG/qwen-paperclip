# Variáveis de ambiente para Qwen Paperclip

# Database
DATABASE_URL=postgresql://paperclip:paperclip_secret@localhost:5432/paperclip

# API Server
NODE_ENV=development
PORT=3100

# Qwen Code Configuration
QWEN_APPROVAL_MODE=yolo
QWEN_OUTPUT_FORMAT=json

# OAuth (automático, não precisa configurar)
# O Qwen Code gerencia OAuth automaticamente via browser

# Logging
LOG_LEVEL=info

# Telemetry (opcional, desabilitar se preferir)
# PAPERCLIP_TELEMETRY_DISABLED=1
# DO_NOT_TRACK=1
